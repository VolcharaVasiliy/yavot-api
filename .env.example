# Yandex auth for "living voice" (voice cloning).
# Get Session_id from your logged-in Yandex Browser cookies (see cookies.txt on desktop),
# OR an OAuth token from https://oauth.yandex.ru (apiToken -> Authorization: OAuth <token>).
# Leave empty to use classic (non-cloned) voices. NEVER commit real values.
YANDEX_SESSION_ID=
YANDEX_API_TOKEN=

# System proxy (Clash / etc). Set to "off" to disable. Default: http://127.0.0.1:7897
YAVOT_PROXY=http://127.0.0.1:7897

# Optional media resolver for arbitrary (non-YouTube) page URLs. When set, the API
# auto-extracts a direct media URL before translating. Point this at your self-hosted
# resolver (see resolver/server.mjs) or any Cobalt-compatible service.
# RESOLVER_URL=http://localhost:8787

# Universal resolver via ytdlp.online (online yt-dlp wrapper). When set to a truthy
# value, the API auto-extracts a re-hosted media URL for ANY site yt-dlp supports
# (no VPS / no binary needed). Optional cookie from ytdlp.online session.
# YTDLP_ONLINE=1
# YTDLP_ONLINE_COOKIE=_sid=652e8b9a-...; other=...

# Max time (ms) the API blocks while polling Yandex in a single call (keep under Vercel timeout).
POLL_BUDGET_MS=9000
