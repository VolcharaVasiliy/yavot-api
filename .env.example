# Yandex auth for "living voice" (voice cloning).
# Get Session_id from your logged-in Yandex Browser cookies (see cookies.txt on desktop),
# OR an OAuth token from https://oauth.yandex.ru (apiToken -> Authorization: OAuth <token>).
# Leave empty to use classic (non-cloned) voices. NEVER commit real values.
YANDEX_SESSION_ID=
YANDEX_API_TOKEN=

# System proxy (Clash / etc). Set to "off" to disable. Default: http://127.0.0.1:7897
YAVOT_PROXY=http://127.0.0.1:7897

# Max time (ms) the API blocks while polling Yandex in a single call (keep under Vercel timeout).
POLL_BUDGET_MS=9000
